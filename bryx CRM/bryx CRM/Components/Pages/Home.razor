    private async Task LoadStatistics()
    {
        isLoading = true;

        try
        {
            using var context = await DbContextFactory.CreateDbContextAsync();

            // Загрузка основных метрик по товарам с учетом фильтра по датам
            var allProducts = await context.Products.ToListAsync();

            // Фильтрация товаров по периоду в зависимости от статуса
            inStockCount = allProducts.Count(p => p.Status == "В наличии" &&
                (p.ArrivalDate.HasValue ? p.ArrivalDate.Value >= dateFrom && p.ArrivalDate.Value <= dateTo
                                        : p.CreatedAt >= dateFrom && p.CreatedAt <= dateTo));
            inStockValue = allProducts.Where(p => p.Status == "В наличии" &&
                (p.ArrivalDate.HasValue ? p.ArrivalDate.Value >= dateFrom && p.ArrivalDate.Value <= dateTo
                                        : p.CreatedAt >= dateFrom && p.CreatedAt <= dateTo))
                .Sum(p => p.PurchasePrice);

            expectedCount = allProducts.Count(p => p.Status == "Ожидается" &&
                p.CreatedAt >= dateFrom && p.CreatedAt <= dateTo);
            expectedValue = allProducts.Where(p => p.Status == "Ожидается" &&
                p.CreatedAt >= dateFrom && p.CreatedAt <= dateTo)
                .Sum(p => p.PurchasePrice);

            shippedCount = allProducts.Count(p => p.Status == "Отправлено" &&
                (p.DeliveryDate.HasValue ? p.DeliveryDate.Value >= dateFrom && p.DeliveryDate.Value <= dateTo
                                         : p.SaleDate.HasValue && p.SaleDate.Value >= dateFrom && p.SaleDate.Value <= dateTo));
            shippedValue = allProducts.Where(p => p.Status == "Отправлено" &&
                (p.DeliveryDate.HasValue ? p.DeliveryDate.Value >= dateFrom && p.DeliveryDate.Value <= dateTo
                                         : p.SaleDate.HasValue && p.SaleDate.Value >= dateFrom && p.SaleDate.Value <= dateTo))
                .Sum(p => p.SalePrice);

            soldCount = allProducts.Count(p => p.Status == "Продано" &&
                p.SaleDate.HasValue && p.SaleDate.Value >= dateFrom && p.SaleDate.Value <= dateTo);
            soldValue = allProducts.Where(p => p.Status == "Продано" &&
                p.SaleDate.HasValue && p.SaleDate.Value >= dateFrom && p.SaleDate.Value <= dateTo)
                .Sum(p => p.SalePrice);

            // Финансовые расчеты - ИСПРАВЛЕННЫЙ МЕТОД v3
            // ВАЖНО: Используем одни и те же Sales для расчета выручки и затрат
            // ИСПОЛЬЗУЕМ SaleDate - дату которую пользователь присваивает продаже

            // 1. Берем все Sales в выбранном периоде (по дате продажи SaleDate)
            var salesInPeriod = await context.Sales
                .Where(s => s.SaleDate >= dateFrom && s.SaleDate <= dateTo)
                .ToListAsync();

            // ОТЛАДКА: Выводим информацию о продажах
            Console.WriteLine($"🔍 DEBUG: Найдено продаж в периоде (по SaleDate): {salesInPeriod.Count}");
            foreach (var sale in salesInPeriod)
            {
                Console.WriteLine($"   - Sale ID: {sale.Id}, Buyer: {sale.Buyer}, Status: {sale.Status}, Amount: {sale.TotalAmount:N2}, SaleDate: {sale.SaleDate}");
            }

            // 2. Получаем ID всех Sales в периоде
            var saleIdsInPeriod = salesInPeriod.Select(s => s.Id).ToHashSet();

            // 3. Выручка = сумма TotalAmount только для завершенных продаж (статус "Получено")
            totalRevenue = salesInPeriod.Where(s => s.Status == "Получено").Sum(s => s.TotalAmount);
            Console.WriteLine($"💰 DEBUG: Выручка (только получено): {totalRevenue:N2}");

            // 4. Затраты = себестоимость товаров из этих Sales (неважно статус Sale)
            //    Берем все Products, которые привязаны к Sales в периоде
            var productsInSales = allProducts
                .Where(p => p.SaleId.HasValue && saleIdsInPeriod.Contains(p.SaleId.Value))
                .ToList();

            var productCosts = productsInSales.Sum(p => p.PurchasePrice);
            Console.WriteLine($"📦 DEBUG: Товаров в продажах периода: {productsInSales.Count}, Затраты на товары: {productCosts:N2}");

            // ОТЛАДКА: Проверка товаров
            foreach (var product in productsInSales)
            {
                Console.WriteLine($"   - Product ID: {product.Id}, SaleId: {product.SaleId}, Purchase: {product.PurchasePrice:N2}, Sale: {product.SalePrice:N2}");
            }

            // 5. Расходы = все расходы из таблицы Expenses в выбранном периоде
            var allExpenses = await context.Expenses
                .Where(e => e.ExpenseDate >= dateFrom && e.ExpenseDate <= dateTo)
                .ToListAsync();
            totalExpenses = allExpenses.Sum(e => e.Amount);
            Console.WriteLine($"💸 DEBUG: Всего расходов: {allExpenses.Count}, Сумма расходов: {totalExpenses:N2}");

            // 6. Прибыль = Выручка - Затраты на товары - Расходы
            totalProfit = totalRevenue - productCosts - totalExpenses;
            Console.WriteLine($"💵 DEBUG: Прибыль = {totalRevenue:N2} - {productCosts:N2} - {totalExpenses:N2} = {totalProfit:N2}");

            // 7. Маржа = (Прибыль / Выручка) * 100
            if (totalRevenue > 0)
            {
                averageMargin = (totalProfit / totalRevenue) * 100;
            }
            else
            {
                averageMargin = 0;
            }
            Console.WriteLine($"📊 DEBUG: Маржа = ({totalProfit:N2} / {totalRevenue:N2}) * 100 = {averageMargin:N2}%");

            // Сальдо = Текущие активы (в наличии + ожидается + отправлено)
            totalBalance = inStockValue + expectedValue + shippedValue;

            // Загрузка последних продаж с учетом периода (по SaleDate)
            var sales = await context.Sales
                .Where(s => s.SaleDate >= dateFrom &&
                            s.SaleDate <= dateTo)
                .OrderByDescending(s => s.SaleDate)
                .Take(5)
                .ToListAsync();

            recentSales = new List<SaleInfo>();
            foreach (var sale in sales)
            {
                var products = await context.Products.Where(p => p.SaleId == sale.Id).ToListAsync();
                recentSales.Add(new SaleInfo
                {
                    Buyer = sale.Buyer ?? "Неизвестно",
                    SaleDate = sale.SaleDate,
                    TotalAmount = sale.TotalAmount,
                    ProductCount = products.Count,
                    Status = sale.Status ?? "Отправлено"
                });
            }

            // Статистика по категориям (только товары в наличии в выбранном периоде)
            var inStockProducts = allProducts.Where(p => p.Status == "В наличии" &&
                (p.ArrivalDate.HasValue ? p.ArrivalDate.Value >= dateFrom && p.ArrivalDate.Value <= dateTo
                                        : p.CreatedAt >= dateFrom && p.CreatedAt <= dateTo)).ToList();
            var totalInStock = inStockProducts.Count;

            if (totalInStock > 0)
            {
                categoryStats = inStockProducts
                    .GroupBy(p => p.Category)
                    .Select(g => new CategoryStat
                    {
                        CategoryName = g.Key,
                        Count = g.Count(),
                        Percentage = (g.Count() * 100.0 / totalInStock)
                    })
                    .OrderByDescending(c => c.Count)
                    .ToList();
            }

            // Избранные товары (без фильтра по дате - показываем все избранные)
            favoriteProducts = allProducts
                .Where(p => p.IsFavorite)
                .OrderBy(p => p.Category)
                .ThenBy(p => p.Name)
                .Take(10)
                .ToList();

            // Подготовка данных для графиков с учетом периода
            await PrepareChartData(allProducts.Where(p =>
            {
                // Определяем дату для фильтрации в зависимости от статуса
                DateTime? relevantDate = p.Status switch
                {
                    "В наличии" => p.ArrivalDate ?? p.CreatedAt,
                    "Ожидается" => p.CreatedAt,
                    "Отправлено" => p.DeliveryDate ?? p.SaleDate,
                    "Продано" => p.SaleDate,
                    _ => p.CreatedAt
                };

                return relevantDate.HasValue && relevantDate.Value >= dateFrom && relevantDate.Value <= dateTo;
            }).ToList());
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task PrepareChartData(List<Product> allProducts)
    {
        using var context = await DbContextFactory.CreateDbContextAsync();

        // Данные по категориям
        categoryData = allProducts
            .GroupBy(p => p.Category)
            .Select(g => new AnalyticsData
            {
                Label = g.Key,
                Balance = g.Sum(p => (p.Status == "В наличии" || p.Status == "Ожидается" || p.Status == "Отправлено") ? p.PurchasePrice : 0),
                Revenue = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice),
                Profit = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice),
                Margin = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice) > 0
                    ? (g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice) / g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice)) * 100
                    : 0,
                Costs = g.Sum(p => p.PurchasePrice),
                Units = g.Count(),
                Returns = g.Count(p => p.Status == "Возврат" || p.Status == "Частичный возврат"),
                Defective = g.Count(p => p.IsDefective)
            })
            .OrderByDescending(d => d.Revenue)
            .Take(10)
            .ToList();

        // Данные по моделям (названиям товаров) - учитываем фильтр по категории
        var productsForModels = string.IsNullOrEmpty(selectedCategory)
            ? allProducts
            : allProducts.Where(p => p.Category == selectedCategory).ToList();

        modelData = productsForModels
            .GroupBy(p => p.Name)
            .Select(g => new AnalyticsData
            {
                Label = g.Key,
                Balance = g.Sum(p => (p.Status == "В наличии" || p.Status == "Ожидается" || p.Status == "Отправлено") ? p.PurchasePrice : 0),
                Revenue = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice),
                Profit = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice),
                Margin = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice) > 0
                    ? (g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice) / g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice)) * 100
                    : 0,
                Costs = g.Sum(p => p.PurchasePrice),
                Units = g.Count(),
                Returns = g.Count(p => p.Status == "Возврат" || p.Status == "Частичный возврат"),
                Defective = g.Count(p => p.IsDefective)
            })
            .OrderByDescending(d => d.Revenue)
            .Take(10)
            .ToList();

        // Данные по цветам
        colorData = allProducts
            .Where(p => !string.IsNullOrWhiteSpace(p.Color))
            .GroupBy(p => p.Color)
            .Select(g => new AnalyticsData
            {
                Label = g.Key ?? "Без цвета",
                Balance = g.Sum(p => (p.Status == "В наличии" || p.Status == "Ожидается" || p.Status == "Отправлено") ? p.PurchasePrice : 0),
                Revenue = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice),
                Profit = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice),
                Margin = g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice) > 0
                    ? (g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice - p.PurchasePrice) / g.Where(p => p.Status == "Продано").Sum(p => p.SalePrice)) * 100
                    : 0,
                Costs = g.Sum(p => p.PurchasePrice),
                Units = g.Count(),
                Returns = g.Count(p => p.Status == "Возврат" || p.Status == "Частичный возврат"),
                Defective = g.Count(p => p.IsDefective)
            })
            .OrderByDescending(d => d.Revenue)
            .Take(10)
            .ToList();
    }

    private async Task RenderCharts()
    {
        try
        {
            Console.WriteLine($"RenderCharts called. Category data count: {categoryData.Count}, Model data count: {modelData.Count}, Color data count: {colorData.Count}");

            if (categoryData.Any())
            {
                Console.WriteLine("Rendering category chart...");
                await JSRuntime.InvokeVoidAsync("renderAnalyticsChart", "categoryChart",
                    JsonSerializer.Serialize(categoryData.Select(d => d.Label).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => (double)d.Balance).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => (double)d.Revenue).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => (double)d.Profit).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => (double)d.Margin).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => (double)d.Costs).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => d.Units).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => d.Returns).ToList()),
                    JsonSerializer.Serialize(categoryData.Select(d => d.Defective).ToList())
                );
                Console.WriteLine("Category chart rendered successfully");
            }
            else
            {
                Console.WriteLine("No category data to display");
            }

            if (modelData.Any())
            {
                Console.WriteLine("Rendering model chart...");
                await JSRuntime.InvokeVoidAsync("renderAnalyticsChart", "modelChart",
                    JsonSerializer.Serialize(modelData.Select(d => d.Label).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => (double)d.Balance).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => (double)d.Revenue).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => (double)d.Profit).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => (double)d.Margin).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => (double)d.Costs).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => d.Units).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => d.Returns).ToList()),
                    JsonSerializer.Serialize(modelData.Select(d => d.Defective).ToList())
                );
                Console.WriteLine("Model chart rendered successfully");
            }
            else
            {
                Console.WriteLine("No model data to display");
            }

            if (colorData.Any())
            {
                Console.WriteLine("Rendering color chart...");
                await JSRuntime.InvokeVoidAsync("renderAnalyticsChart", "colorChart",
                    JsonSerializer.Serialize(colorData.Select(d => d.Label).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => (double)d.Balance).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => (double)d.Revenue).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => (double)d.Profit).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => (double)d.Margin).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => (double)d.Costs).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => d.Units).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => d.Returns).ToList()),
                    JsonSerializer.Serialize(colorData.Select(d => d.Defective).ToList())
                );
                Console.WriteLine("Color chart rendered successfully");
            }
            else
            {
                Console.WriteLine("No color data to display");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Получено" => "bg-success",
            "Отправлено" => "bg-info",
            "Возврат" => "bg-danger",
            "Частичный возврат" => "bg-warning",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "Получено" => "ПРОДАНО ✓",
            "Отправлено" => "В ПУТИ",
            "Возврат" => "ВОЗВРАТ",
            "Частичный возврат" => "ЧАС. ВОЗВРАТ",
            _ => status
        };
    }

    private string GetProductStatusBadgeClass(string status)
    {
        return status switch
        {
            "В наличии" => "bg-success",
            "Ожидается" => "bg-warning",
            "Отправлено" => "bg-info",
            "Продано" => "bg-primary",
            _ => "bg-secondary"
        };
    }

    // Вспомогательные классы
    private class SaleInfo
    {
        public string Buyer { get; set; } = string.Empty;
        public DateTime? SaleDate { get; set; }
        public decimal TotalAmount { get; set; }
        public int ProductCount { get; set; }
        public string Status { get; set; } = string.Empty;
    }

    private class CategoryStat
    {
        public string CategoryName { get; set; } = string.Empty;
        public int Count { get; set; }
        public double Percentage { get; set; }
    }

    private class AnalyticsData
    {
        public string Label { get; set; } = string.Empty;
        public decimal Balance { get; set; }
        public decimal Revenue { get; set; }
        public decimal Profit { get; set; }
        public decimal Margin { get; set; }
        public decimal Costs { get; set; }
        public int Units { get; set; }
        public int Returns { get; set; }
        public int Defective { get; set; }
    }
