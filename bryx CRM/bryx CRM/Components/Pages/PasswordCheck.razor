@page "/password-check"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using bryx_CRM.Data.Models
@using bryx_CRM.Data
@using System.ComponentModel.DataAnnotations
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Управление пользователями</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-dark text-white">
            <h3>👥 Управление пользователями</h3>
            <p class="mb-0 small">Администрирование учётных записей системы</p>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show">
                    ✅ @successMessage
                    <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    ❌ @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            <!-- Кнопка добавления нового пользователя -->
            <div class="mb-3">
                <button class="btn btn-primary" @onclick="ShowAddUserModal">
                    ➕ Добавить пользователя
                </button>
            </div>

            @if (users == null)
            {
                <p><em>Загрузка данных...</em></p>
            }
            else if (!users.Any())
            {
                <div class="alert alert-warning">
                    ⚠️ В системе нет пользователей
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <strong>ℹ️ Информация:</strong><br/>
                    Текущий пользователь: <strong>@currentUserEmail</strong><br/>
                    Всего пользователей: <strong>@users.Count</strong>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Email</th>
                                <th>Полное имя</th>
                                <th>Создан</th>
                                <th>Последний вход</th>
                                <th>Статус</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                var isCurrentUser = user.Email?.Equals(currentUserEmail, StringComparison.OrdinalIgnoreCase) ?? false;
                                <tr class="@(isCurrentUser ? "table-info" : "")">
                                    <td>
                                        @user.Email
                                        @if (isCurrentUser)
                                        {
                                            <span class="badge bg-info">Вы</span>
                                        }
                                    </td>
                                    <td>@user.FullName</td>
                                    <td>
                                        <small>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (user.LastLoginAt.HasValue)
                                        {
                                            <small>@user.LastLoginAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                        }
                                        else
                                        {
                                            <small class="text-muted">Никогда</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.PasswordHash))
                                        {
                                            <span class="badge bg-success">✅ Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">❌ Нет пароля</span>
                                        }
                                        @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-warning">🔒 Заблокирован</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-warning" @onclick="() => ShowChangePasswordModal(user)">
                                            🔑 Сменить пароль
                                        </button>
                                        @if (!isCurrentUser)
                                        {
                                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmation(user)">
                                                🗑️ Удалить
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary" disabled title="Нельзя удалить себя">
                                                🗑️ Удалить
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr />

                <div class="card bg-light">
                    <div class="card-body">
                        <h5>🔐 Информация о безопасности:</h5>
                        <ul>
                            <li><strong>Алгоритм хеширования:</strong> PBKDF2-HMAC-SHA256</li>
                            <li><strong>Итерации:</strong> 10,000</li>
                            <li><strong>Защита:</strong> Каждый пароль имеет уникальную соль</li>
                            <li><strong>Блокировка:</strong> После 5 неудачных попыток входа</li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Раздел управления пользователями бота -->
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h3>🤖 Пользователи Telegram бота</h3>
            <p class="mb-0 small">Управление доступом к Telegram боту</p>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(botSuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show">
                    ✅ @botSuccessMessage
                    <button type="button" class="btn-close" @onclick="() => botSuccessMessage = null"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(botErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    ❌ @botErrorMessage
                    <button type="button" class="btn-close" @onclick="() => botErrorMessage = null"></button>
                </div>
            }

            <!-- Кнопка добавления пользователя бота -->
            <div class="mb-3">
                <button class="btn btn-primary" @onclick="ShowAddBotUserModal">
                    ➕ Добавить пользователя в бота
                </button>
            </div>

            @if (botUsers == null)
            {
                <p><em>Загрузка данных...</em></p>
            }
            else if (!botUsers.Any())
            {
                <div class="alert alert-warning">
                    ⚠️ Нет пользователей бота
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <strong>ℹ️ Информация:</strong><br/>
                    Всего пользователей бота: <strong>@botUsers.Count</strong>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Username</th>
                                <th>Имя</th>
                                <th>Описание</th>
                                <th>Статус</th>
                                <th>Создан</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var botUser in botUsers)
                            {
                                <tr>
                                    <td><code>@@@(botUser.Username ?? botUser.ChatId ?? "?")</code></td>
                                    <td>@(botUser.Name ?? "-")</td>
                                    <td>@(botUser.Description ?? "-")</td>
                                    <td>
                                        @if (botUser.IsActive)
                                        {
                                            <span class="badge bg-success">✅ Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">❌ Неактивен</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@botUser.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteBotUserConfirmation(botUser)">
                                            🗑️ Удалить
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Модальное окно смены пароля -->
@if (showPasswordModal && selectedUser != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">🔑 Сменить пароль для @selectedUser.Email</h5>
                    <button type="button" class="btn-close" @onclick="ClosePasswordModal"></button>
                </div>
                <EditForm Model="@passwordModel" OnValidSubmit="ChangePassword">
                    <DataAnnotationsValidator />
                    <div class="modal-body text-dark bg-white">
                        <div class="mb-3">
                            <label class="form-label">Новый пароль:</label>
                            <InputText type="password" class="form-control" @bind-Value="passwordModel.NewPassword" />
                            <ValidationMessage For="@(() => passwordModel.NewPassword)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Подтвердите пароль:</label>
                            <InputText type="password" class="form-control" @bind-Value="passwordModel.ConfirmPassword" />
                            <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="ClosePasswordModal">Отмена</button>
                        <button type="submit" class="btn btn-primary" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span>⏳ Сохранение...</span>
                            }
                            else
                            {
                                <span>💾 Сохранить</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Модальное окно добавления пользователя -->
@if (showAddUserModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">➕ Добавить нового пользователя</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddUserModal"></button>
                </div>
                <EditForm Model="@newUserModel" OnValidSubmit="AddUser">
                    <DataAnnotationsValidator />
                    <div class="modal-body text-dark bg-white">
                        <div class="mb-3">
                            <label class="form-label">Email:</label>
                            <InputText type="email" class="form-control" @bind-Value="newUserModel.Email" />
                            <ValidationMessage For="@(() => newUserModel.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Полное имя:</label>
                            <InputText class="form-control" @bind-Value="newUserModel.FullName" />
                            <ValidationMessage For="@(() => newUserModel.FullName)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Пароль:</label>
                            <InputText type="password" class="form-control" @bind-Value="newUserModel.Password" />
                            <ValidationMessage For="@(() => newUserModel.Password)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Подтвердите пароль:</label>
                            <InputText type="password" class="form-control" @bind-Value="newUserModel.ConfirmPassword" />
                            <ValidationMessage For="@(() => newUserModel.ConfirmPassword)" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddUserModal">Отмена</button>
                        <button type="submit" class="btn btn-primary" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span>⏳ Создание...</span>
                            }
                            else
                            {
                                <span>➕ Создать</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Модальное окно подтверждения удаления -->
@if (showDeleteModal && selectedUser != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⚠️ Подтверждение удаления</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body text-dark bg-white">
                    <p>Вы уверены, что хотите удалить пользователя?</p>
                    <p><strong>Email:</strong> @selectedUser.Email</p>
                    <p><strong>Имя:</strong> @selectedUser.FullName</p>
                    <p class="text-danger"><strong>⚠️ Это действие нельзя отменить!</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteModal">Отмена</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteUser" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span>⏳ Удаление...</span>
                        }
                        else
                        {
                            <span>🗑️ Удалить</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Модальное окно добавления пользователя бота -->
@if (showAddBotUserModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">➕ Добавить пользователя в бота</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddBotUserModal"></button>
                </div>
                <EditForm Model="@newBotUserModel" OnValidSubmit="AddBotUser">
                    <DataAnnotationsValidator />
                    <div class="modal-body text-dark bg-white">
                        <div class="mb-3">
                            <label class="form-label">Telegram Username: <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="newBotUserModel.Username" placeholder="@username или username" />
                            <ValidationMessage For="@(() => newBotUserModel.Username)" />
                            <small class="form-text text-muted">
                                Telegram username пользователя (можно с @ или без)
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Имя:</label>
                            <InputText class="form-control" @bind-Value="newBotUserModel.Name" placeholder="Иван Иванов" />
                            <ValidationMessage For="@(() => newBotUserModel.Name)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Описание:</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="newBotUserModel.Description" placeholder="Менеджер по продажам" />
                            <ValidationMessage For="@(() => newBotUserModel.Description)" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseAddBotUserModal">Отмена</button>
                        <button type="submit" class="btn btn-primary" disabled="@isBotLoading">
                            @if (isBotLoading)
                            {
                                <span>⏳ Добавление...</span>
                            }
                            else
                            {
                                <span>➕ Добавить</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<!-- Модальное окно подтверждения удаления пользователя бота -->
@if (showDeleteBotUserModal && selectedBotUser != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">⚠️ Подтверждение удаления</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteBotUserModal"></button>
                </div>
                <div class="modal-body text-dark bg-white">
                    <p>Вы уверены, что хотите удалить пользователя бота?</p>
                    <p><strong>Chat ID:</strong> @selectedBotUser.ChatId</p>
                    @if (!string.IsNullOrEmpty(selectedBotUser.Name))
                    {
                        <p><strong>Имя:</strong> @selectedBotUser.Name</p>
                    }
                    <p class="text-danger"><strong>⚠️ Пользователь потеряет доступ к боту!</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteBotUserModal">Отмена</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteBotUser" disabled="@isBotLoading">
                        @if (isBotLoading)
                        {
                            <span>⏳ Удаление...</span>
                        }
                        else
                        {
                            <span>🗑️ Удалить</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .modal.show {
        display: block;
    }

    .table-info {
        background-color: rgba(13, 110, 253, 0.1);
    }

    .btn-sm {
        margin-right: 5px;
    }
</style>

@code {
    private List<ApplicationUser>? users;
    private string? currentUserEmail;
    private string? successMessage;
    private string? errorMessage;
    private bool isLoading = false;

    // Модальные окна
    private bool showPasswordModal = false;
    private bool showAddUserModal = false;
    private bool showDeleteModal = false;
    private ApplicationUser? selectedUser = null;

    // Модели форм
    private PasswordChangeModel passwordModel = new();
    private NewUserModel newUserModel = new();

    // Bot users management
    private List<BotUser>? botUsers;
    private string? botSuccessMessage;
    private string? botErrorMessage;
    private bool isBotLoading = false;

    // Bot modals
    private bool showAddBotUserModal = false;
    private bool showDeleteBotUserModal = false;
    private BotUser? selectedBotUser = null;

    // Bot models
    private NewBotUserModel newBotUserModel = new();

    protected override async Task OnInitializedAsync()
    {
        // Получаем текущего пользователя
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserEmail = authState.User.Identity?.Name;

        await LoadUsers();
        await LoadBotUsers();
    }

    private async Task LoadUsers()
    {
        await using var context = await DbContextFactory.CreateDbContextAsync();
        users = await context.Users
            .OrderBy(u => u.Email)
            .ToListAsync();
    }

    private async Task LoadBotUsers()
    {
        await using var context = await DbContextFactory.CreateDbContextAsync();
        botUsers = await context.BotUsers
            .OrderByDescending(u => u.CreatedAt)
            .ToListAsync();
    }

    // === Смена пароля ===
    private void ShowChangePasswordModal(ApplicationUser user)
    {
        selectedUser = user;
        passwordModel = new PasswordChangeModel();
        showPasswordModal = true;
    }

    private void ClosePasswordModal()
    {
        showPasswordModal = false;
        selectedUser = null;
        passwordModel = new();
    }

    private async Task ChangePassword()
    {
        if (selectedUser == null) return;

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var user = await UserManager.FindByIdAsync(selectedUser.Id);
            if (user == null)
            {
                errorMessage = "Пользователь не найден";
                return;
            }

            // Удаляем старый пароль и устанавливаем новый (admin reset)
            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var result = await UserManager.ResetPasswordAsync(user, token, passwordModel.NewPassword);

            if (result.Succeeded)
            {
                successMessage = $"Пароль для {user.Email} успешно изменён";
                ClosePasswordModal();
                await LoadUsers();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // === Добавление пользователя ===
    private void ShowAddUserModal()
    {
        newUserModel = new NewUserModel();
        showAddUserModal = true;
    }

    private void CloseAddUserModal()
    {
        showAddUserModal = false;
        newUserModel = new();
    }

    private async Task AddUser()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var user = new ApplicationUser
            {
                UserName = newUserModel.Email,
                Email = newUserModel.Email,
                FullName = newUserModel.FullName,
                EmailConfirmed = true,
                CreatedAt = DateTime.UtcNow
            };

            var result = await UserManager.CreateAsync(user, newUserModel.Password);

            if (result.Succeeded)
            {
                successMessage = $"Пользователь {user.Email} успешно создан";
                CloseAddUserModal();
                await LoadUsers();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // === Удаление пользователя ===
    private void ShowDeleteConfirmation(ApplicationUser user)
    {
        selectedUser = user;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        selectedUser = null;
    }

    private async Task DeleteUser()
    {
        if (selectedUser == null) return;

        // Дополнительная проверка - нельзя удалить себя
        if (selectedUser.Email?.Equals(currentUserEmail, StringComparison.OrdinalIgnoreCase) ?? false)
        {
            errorMessage = "Нельзя удалить текущего пользователя!";
            CloseDeleteModal();
            return;
        }

        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var user = await UserManager.FindByIdAsync(selectedUser.Id);
            if (user == null)
            {
                errorMessage = "Пользователь не найден";
                return;
            }

            var result = await UserManager.DeleteAsync(user);

            if (result.Succeeded)
            {
                successMessage = $"Пользователь {user.Email} успешно удалён";
                CloseDeleteModal();
                await LoadUsers();
            }
            else
            {
                errorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // === Управление пользователями бота ===
    private void ShowAddBotUserModal()
    {
        newBotUserModel = new NewBotUserModel();
        showAddBotUserModal = true;
    }

    private void CloseAddBotUserModal()
    {
        showAddBotUserModal = false;
        newBotUserModel = new();
    }

    private async Task AddBotUser()
    {
        isBotLoading = true;
        botErrorMessage = null;
        botSuccessMessage = null;

        try
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();

            // Нормализуем username (удаляем @ если есть, приводим к нижнему регистру)
            var normalizedUsername = newBotUserModel.Username.TrimStart('@').ToLower();

            // Проверяем, не существует ли уже такой Username
            var existing = await context.BotUsers
                .FirstOrDefaultAsync(u => u.Username != null && u.Username.ToLower() == normalizedUsername);

            if (existing != null)
            {
                botErrorMessage = $"Пользователь с username @{normalizedUsername} уже существует";
                return;
            }

            var botUser = new BotUser
            {
                Username = normalizedUsername,
                Name = newBotUserModel.Name,
                Description = newBotUserModel.Description,
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            };

            context.BotUsers.Add(botUser);
            await context.SaveChangesAsync();

            botSuccessMessage = $"Пользователь @{botUser.Username} успешно добавлен в бота";
            CloseAddBotUserModal();
            await LoadBotUsers();
        }
        catch (Exception ex)
        {
            botErrorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isBotLoading = false;
        }
    }

    private void ShowDeleteBotUserConfirmation(BotUser botUser)
    {
        selectedBotUser = botUser;
        showDeleteBotUserModal = true;
    }

    private void CloseDeleteBotUserModal()
    {
        showDeleteBotUserModal = false;
        selectedBotUser = null;
    }

    private async Task DeleteBotUser()
    {
        if (selectedBotUser == null) return;

        isBotLoading = true;
        botErrorMessage = null;
        botSuccessMessage = null;

        try
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();

            var botUser = await context.BotUsers.FindAsync(selectedBotUser.Id);
            if (botUser == null)
            {
                botErrorMessage = "Пользователь не найден";
                return;
            }

            context.BotUsers.Remove(botUser);
            await context.SaveChangesAsync();

            botSuccessMessage = $"Пользователь с Chat ID {botUser.ChatId} удалён из бота";
            CloseDeleteBotUserModal();
            await LoadBotUsers();
        }
        catch (Exception ex)
        {
            botErrorMessage = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isBotLoading = false;
        }
    }

    // === Модели данных ===
    public class PasswordChangeModel
    {
        [Required(ErrorMessage = "Введите новый пароль")]
        [MinLength(6, ErrorMessage = "Минимум 6 символов")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Подтвердите пароль")]
        [Compare(nameof(NewPassword), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    public class NewUserModel
    {
        [Required(ErrorMessage = "Email обязателен")]
        [EmailAddress(ErrorMessage = "Неверный формат email")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Полное имя обязательно")]
        public string FullName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Пароль обязателен")]
        [MinLength(6, ErrorMessage = "Минимум 6 символов")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Подтвердите пароль")]
        [Compare(nameof(Password), ErrorMessage = "Пароли не совпадают")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    public class NewBotUserModel
    {
        [Required(ErrorMessage = "Username обязателен")]
        [RegularExpression(@"^@?[a-zA-Z0-9_]{5,32}$", ErrorMessage = "Username должен содержать от 5 до 32 символов (буквы, цифры, подчёркивание)")]
        public string Username { get; set; } = string.Empty;

        [StringLength(200, ErrorMessage = "Максимум 200 символов")]
        public string? Name { get; set; }

        [StringLength(500, ErrorMessage = "Максимум 500 символов")]
        public string? Description { get; set; }
    }
}
