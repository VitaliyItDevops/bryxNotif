# ============================================
# BRYX CRM + BOT - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# WARNING: Never commit .env file to git!

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# Railway automatically provides DATABASE_URL
# For local development, use:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bryx_crm

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Comma-separated list of allowed Telegram user IDs
ALLOWED_USERS=123456789,987654321

# ============================================
# CRM API CONFIGURATION
# ============================================
# For production (Railway), this will be your CRM service URL
# For local development:
CRM_API_URL=http://localhost:5092/api/bot/

# ============================================
# RAILWAY SPECIFIC (Auto-provided)
# ============================================
# These are automatically set by Railway, no need to configure:
# - RAILWAY_VOLUME_MOUNT_PATH (for backups storage)
# - PORT (application port)
# - ASPNETCORE_ENVIRONMENT (set to Production)

# ============================================
# BACKUP CONFIGURATION (Optional)
# ============================================
# Directory for database backups (will use Railway volume if available)
BACKUP_DIRECTORY=/app/backups

# Maximum number of backups to keep
MAX_BACKUPS=10

# Enable automatic backups
AUTO_BACKUP_ENABLED=true

# Backup interval in hours
AUTO_BACKUP_INTERVAL=24
